const state = { qs: [], ans: [], inputs: [], blankConfirm: false, res: [] };

/* ================= 画面切り替え ================= */
function show(id) {
  ['start', 'test', 'result'].forEach((v) => { $('#' + v).hidden = (v !== id); });
  window.scrollTo(0, 0);
}

/* ================= 開始画面 ================= */
function applyLevelUI() {
  const L = LV[curLv];
  $('#lvTitle').textContent = L.name;
  setText($('#lvDesc'), L.name + '：' + L.desc + '。');
  const r = document.querySelector('input[name=level][value="' + curLv + '"]');
  if (r) r.checked = true;
}
function refreshCounts() {
  const bank = lvBank(curLv);
  const cnt = { all: 0, on: 0, kun: 0, sp: 0 };
  bank.forEach((q) => { if (stOf(q) === '') { cnt[q.c]++; cnt.all++; } });
  const w = bank.filter(isWeak).length;
  const d = bank.filter(isDone).length;
  setText($('#doneNote'), (d === 0 && w === 0) ? '' :
    '正解済み ' + d + ' / ' + bank.length + '問（出題されません）・苦手 ' + w + '問（「苦手だけ」で出題）');
  $('#resetBtn').hidden = (d === 0);
  $('#totalCount').textContent = bank.length;
  LEVELS.forEach((l) => { $('#c-lv-' + l.k).textContent = lvBank(l.k).length; });
  $('#c-all').textContent = cnt.all;
  $('#c-on').textContent = cnt.on;
  $('#c-kun').textContent = cnt.kun;
  $('#c-sp').textContent = cnt.sp;
  $('#c-weak').textContent = w;
  const wr = $('#weakRadio');
  wr.disabled = (w === 0);
  if (w === 0 && wr.checked) document.querySelector('input[name=scope][value=all]').checked = true;
  applyLevelUI();
  refreshTransfer();
}

function buildPool() {
  const scope = document.querySelector('input[name=scope]:checked').value;
  const n = document.querySelector('input[name=count]:checked').value;
  let pool = BANK.filter((q) => q.lv === curLv && (scope === 'weak' ? isWeak(q) : (stOf(q) === '' && (scope === 'all' || q.c === scope))));
  if ($('#shuffle').checked) pool = shuffleArr(pool);
  if (n !== 'all') pool = pool.slice(0, parseInt(n, 10));
  return pool;
}

/* ================= テスト画面 ================= */
function showStartMsg(t) { const m = $('#startMsg'); setText(m, t); m.hidden = false; }
function emptyPoolMsg() {
  const scope = document.querySelector('input[name=scope]:checked').value;
  if (scope === 'weak') return '苦手の問題はありません。';
  return 'この級のこの範囲に、まだ出題していない問題はありません。' +
    (lvBank(curLv).some(isWeak) ? '「苦手だけ」で、まちがえた問題を復習できます。' : '範囲や級を変えるか、正解済みの記録をリセットしてください。');
}
function startTest(list) {
  if (!list.length) { showStartMsg(emptyPoolMsg()); return; }
  $('#startMsg').hidden = true;
  state.qs = list;
  state.ans = list.map(() => '');
  state.blankConfirm = false;
  renderTest();
  show('test');
  if (window.matchMedia && window.matchMedia('(pointer: fine)').matches && state.inputs[0]) state.inputs[0].focus({ preventScroll: true });
}

function renderTest() {
  const ol = $('#qlist');
  ol.textContent = '';
  state.inputs = [];
  state.qs.forEach((q, i) => {
    const li = el('li', 'q');
    li.append(el('div', 'no', String(i + 1)));
    const s = el('p', 's'); s.append(frag(q.s));
    const a = el('div', 'ans');
    const inp = document.createElement('input');
    inp.type = 'text';
    inp.lang = 'ja';
    inp.placeholder = 'ひらがなで入力';
    inp.autocomplete = 'off';
    inp.autocapitalize = 'off';
    inp.spellcheck = false;
    inp.setAttribute('autocorrect', 'off');
    inp.setAttribute('aria-label', '第' + (i + 1) + '問の答え');
    inp.addEventListener('input', () => {
      state.ans[i] = inp.value;
      li.classList.toggle('filled', norm(inp.value) !== '');
      state.blankConfirm = false;
      updateProgress();
    });
    inp.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        const next = state.inputs[i + 1];
        if (next) { next.focus({ preventScroll: true }); next.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
        else { $('#gradeBtn').focus(); }
      }
    });
    a.append(inp);
    li.append(s, a);
    ol.append(li);
    state.inputs.push(inp);
  });
  $('#total').textContent = state.qs.length;
  updateProgress();
}

function answeredCount() { return state.ans.filter((v) => norm(v) !== '').length; }
function updateProgress() {
  const n = answeredCount(), t = state.qs.length;
  $('#answered').textContent = n;
  $('#progBar').style.width = (t ? (n / t * 100) : 0) + '%';
  const m = $('#submitMsg'), b = $('#gradeBtn');
  if (state.blankConfirm) {
    m.textContent = '未回答が' + (t - n) + '問あります。このまま採点しますか？';
    m.className = 'msg warn';
    b.textContent = 'このまま採点する';
  } else {
    m.textContent = n === t ? 'すべて回答しました。' : 'すべて答えたら採点します。';
    m.className = 'msg';
    b.textContent = '採点する';
  }
}

let quitTimer = null;
function onQuit() {
  const b = $('#quitBtn');
  if (answeredCount() === 0 || b.dataset.armed === '1') {
    clearTimeout(quitTimer); b.dataset.armed = ''; b.textContent = '中断する';
    refreshCounts(); show('start'); return;
  }
  b.dataset.armed = '1'; b.textContent = '回答が消えます。もう一度押すと中断';
  quitTimer = setTimeout(() => { b.dataset.armed = ''; b.textContent = '中断する'; }, 3500);
}

/* ================= 採点・結果 ================= */
function onGrade() {
  const blanks = state.qs.length - answeredCount();
  if (blanks > 0 && !state.blankConfirm) { state.blankConfirm = true; updateProgress(); return; }
  state.res = state.qs.map((q, i) => {
    const user = state.ans[i];
    const ok = norm(user) !== '' && q.a.some((x) => norm(x) === norm(user));
    return { q: q, user: user, ok: ok };
  });
  const tm = nowMin();
  state.res.forEach((r) => { rec.set(r.q.s, { s: r.ok ? 'd' : 'w', t: tm }); });
  saveRec();
  renderResult();
  show('result');
}

function renderResult() {
  const res = state.res, total = res.length;
  const ok = res.filter((r) => r.ok).length;
  const pct = total ? Math.round(ok / total * 100) : 0;
  const L = LV[curLv];
  let msg;
  if (pct >= 90) msg = 'ほぼ満点です。この調子で範囲を広げましょう。';
  else if (pct >= L.pass) msg = '合格の目安（正答率およそ' + L.pass + '%）に届いています。';
  else if (pct >= L.pass - 20) msg = 'あと少しです。まちがえた問題を復習しましょう。';
  else msg = 'まずはまちがえた問題から、くり返し解きましょう。';

  const sum = $('#summary');
  sum.textContent = '';
  const score = el('div', 'score');
  const svgNS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(svgNS, 'svg');
  svg.setAttribute('viewBox', '0 0 240 120');
  svg.setAttribute('preserveAspectRatio', 'none');
  svg.setAttribute('aria-hidden', 'true');
  const path = document.createElementNS(svgNS, 'path');
  path.setAttribute('d', 'M126 8 C 190 4, 234 28, 232 60 C 230 94, 178 114, 118 112 C 54 110, 8 90, 10 58 C 12 26, 60 10, 132 12 C 150 13, 160 16, 168 20');
  svg.append(path);
  const num = el('div', 'num');
  num.append(String(ok));
  num.append(el('small', '', '／' + total));
  score.append(svg, num);
  sum.append(score);
  sum.append(el('p', 'pct', '正答率 ' + pct + '%'));
  sum.append(el('p', 'ph', msg));
  sum.append(el('p', 'small ph', '漢検' + L.name + 'の合格目安は、全体の得点率およそ' + L.pass + '%です。'));
  const lc = localCounts(curLv);
  sum.append(el('p', 'small ph', L.name + 'の記録：正解済み ' + lc.d + ' / ' + lvBank(curLv).length + '問・苦手 ' + lc.w + '問。正解した問題は出題されません。まちがえた問題は「苦手だけ」で復習できます。'));
  sum.querySelectorAll('.ph').forEach(phrasify);
  try { const len = Math.ceil(path.getTotalLength()); path.style.strokeDasharray = len; path.style.setProperty('--len', len); } catch (e) { /* アニメ省略 */ }

  $('#onlyWrong').checked = false;
  renderReview();
}

function renderReview() {
  const only = $('#onlyWrong').checked;
  const ol = $('#rlist');
  ol.textContent = '';
  let shown = 0;
  state.res.forEach((r, i) => {
    if (only && r.ok) return;
    shown++;
    const li = el('li', 'r ' + (r.ok ? 'ok' : 'ng'));
    const no = el('div', 'no');
    no.append(el('span', '', String(i + 1)));
    const mk = el('span', 'mark', r.ok ? '○' : '×');
    mk.setAttribute('role', 'img');
    mk.setAttribute('aria-label', r.ok ? '正解' : '不正解');
    no.append(mk);
    const s = el('p', 's'); s.append(frag(r.q.s)); s.append(el('span', 'tag', CAT[r.q.c]));
    const a = el('div', 'ans');
    const you = el('div');
    you.append(el('span', 'lbl', 'あなたの答え'));
    you.append(el('span', 'val', norm(r.user) === '' ? '（未回答）' : r.user));
    a.append(you);
    const right = el('div', 'right');
    right.append(el('span', 'lbl', '正解'));
    right.append(el('span', 'val', r.q.a.join('／')));
    a.append(right);
    li.append(no, s, a);
    ol.append(li);
  });
  if (!shown) {
    const li = el('li', '');
    li.style.padding = '24px 16px';
    li.style.textAlign = 'center';
    li.textContent = 'まちがいはありません。全問正解です。';
    ol.append(li);
  }
}

/* ================= イベント ================= */
$('#startBtn').addEventListener('click', () => startTest(buildPool()));
$('#gradeBtn').addEventListener('click', onGrade);
$('#quitBtn').addEventListener('click', onQuit);
$('#onlyWrong').addEventListener('change', renderReview);
$('#againBtn').addEventListener('click', () => {
  refreshCounts();
  const pool = buildPool();
  if (!pool.length) {
    show('start');
    showStartMsg(emptyPoolMsg());
    return;
  }
  startTest(pool);
});
let resetTimer = null;
$('#resetBtn').addEventListener('click', () => {
  const b = $('#resetBtn');
  const label = 'この級の正解済みの記録をリセット';
  if (b.dataset.armed === '1') {
    clearTimeout(resetTimer); b.dataset.armed = ''; b.textContent = label;
    BANK.forEach((q) => { if (q.lv === curLv && isDone(q)) rec.delete(q.s); });
    saveRec(); $('#startMsg').hidden = true; refreshCounts(); return;
  }
  b.dataset.armed = '1'; b.textContent = 'もう一度押すと、この級の正解済みが未出題に戻ります';
  resetTimer = setTimeout(() => { b.dataset.armed = ''; b.textContent = label; }, 3500);
});
$('#homeBtn').addEventListener('click', () => { refreshCounts(); show('start'); });
document.querySelectorAll('input[name=level]').forEach((r) => {
  r.addEventListener('change', () => {
    if (!r.checked) return;
    curLv = r.value;
    lsSet(LVK, curLv);
    $('#startMsg').hidden = true;
    refreshCounts();
  });
});

/* ================= 記録の引き継ぎ（画面） ================= */
const xfer = $('#xfer'), expCode = $('#expCode'), expInfo = $('#expInfo'), copyBtn = $('#copyBtn'), copyMsg = $('#copyMsg');
const impCode = $('#impCode'), impInfo = $('#impInfo'), mergeBtn = $('#mergeBtn'), replaceBtn = $('#replaceBtn');
const expBoxes = Array.from(document.querySelectorAll('.expLv'));
const ERR = {
  format: 'このコードは読み取れません。「kk3.」で始まる引き継ぎコードを、最後まで貼り付けてください。',
  broken: 'コードが途中で切れているか、文字が欠けています。書き出し側でもう一度コピーして、全体を貼り付けてください。',
  version: 'このコードは、このテストより新しい形式のため読み込めません。'
};
let impParsed = null, replaceTimer = null;

function selectedLevels() {
  const set = new Set();
  expBoxes.forEach((b) => { if (b.checked) set.add(b.value); });
  return set;
}
function refreshExport() {
  copyMsg.textContent = '';
  copyMsg.className = 'info ph';
  LEVELS.forEach((l) => { const c = localCounts(l.k); $('#e-' + l.k).textContent = '（正解済み ' + c.d + '・苦手 ' + c.w + '）'; });
  const sel = selectedLevels();
  if (!sel.size) {
    expCode.value = '';
    setText(expInfo, '書き出す級を選んでください。');
    copyBtn.disabled = true;
    return;
  }
  const b = buildCode(sel);
  if (b.nd + b.nw === 0) {
    expCode.value = '';
    setText(expInfo, '選んだ級には、まだ記録がありません。テストを解くと、ここに引き継ぎコードができます。');
    copyBtn.disabled = true;
  } else {
    expCode.value = b.code;
    setText(expInfo, '正解済み ' + b.nd + '問・苦手 ' + b.nw + '問の記録です（' + b.code.length + '文字）。' +
      (b.code.length > 3000 ? 'コードが長いときは、書き出す級を分けると短くなります。' : ''));
    copyBtn.disabled = false;
  }
}
function refreshTransfer() {
  $('#storeWarn').hidden = storageOK;
  refreshExport();
  if (impCode.value.trim()) updateImport();
}
function disarmReplace() {
  clearTimeout(replaceTimer);
  replaceBtn.dataset.armed = '';
  replaceBtn.textContent = '置き換えて読み込む';
}
function updateImport() {
  disarmReplace();
  impParsed = null;
  mergeBtn.disabled = true;
  replaceBtn.disabled = true;
  impInfo.className = 'info ph';
  if (!impCode.value.trim()) { impInfo.textContent = ''; return; }
  const r = parseCode(impCode.value);
  if (r.err) { impInfo.className = 'info warn ph'; setText(impInfo, ERR[r.err]); return; }
  if (!r.items.length) {
    impInfo.className = 'info warn ph';
    setText(impInfo, r.unknown ? 'このコードの記録は、いまのテストにない問題のものです。読み込めません。' : '記録が入っていないコードです。');
    return;
  }
  impParsed = r;
  const inMask = LEVELS.filter((l) => r.mask & l.bit);
  const parts = inMask.map((l) => l.name + '（正解済み ' + r.by[l.k].d + '・苦手 ' + r.by[l.k].w + '）');
  let ld = 0, lw = 0;
  inMask.forEach((l) => { const c = localCounts(l.k); ld += c.d; lw += c.w; });
  setText(impInfo, 'コードの内容：' + parts.join('、') + '。同じ級のこの端末の今の記録：正解済み ' + ld + '問・苦手 ' + lw + '問。' +
    (r.unknown ? '（' + r.unknown + '件は、対応する問題がないので無視します）' : '') +
    '「置き換え」は、' + inMask.map((l) => l.name).join('・') + 'の今の記録だけを入れ替えます。');
  mergeBtn.disabled = false;
  replaceBtn.disabled = false;
}
function doImport(mode) {
  if (!impParsed) return;
  const res = applyImport(impParsed, mode);
  impCode.value = '';
  updateImport();
  refreshCounts();
  const c = localCounts();
  impInfo.className = 'info okmsg ph';
  setText(impInfo, (mode === 'replace' ? '置き換えました。' : '統合して読み込みました（新規 ' + res.added + '問・更新 ' + res.updated + '問）。') +
    'いまの記録（全級）：正解済み ' + c.d + '問・苦手 ' + c.w + '問。');
}
async function copyText(text, ta) {
  try { if (navigator.clipboard && navigator.clipboard.writeText) { await navigator.clipboard.writeText(text); return true; } } catch (e) { /* 次の方法へ */ }
  try { ta.focus(); ta.select(); ta.setSelectionRange(0, text.length); if (document.execCommand('copy')) return true; } catch (e) { /* 失敗 */ }
  return false;
}
xfer.addEventListener('toggle', () => { if (xfer.open) refreshTransfer(); });
expCode.addEventListener('focus', () => { expCode.select(); });
expCode.addEventListener('click', () => { expCode.select(); });
copyBtn.addEventListener('click', async () => {
  const ok = await copyText(expCode.value, expCode);
  copyMsg.className = ok ? 'info okmsg ph' : 'info warn ph';
  setText(copyMsg, ok ? 'コピーしました。別の端末の「読み込む」欄に貼り付けてください。'
                      : '自動でコピーできませんでした。コードを選択した状態にしたので、長押し（パソコンは Ctrl+C）でコピーしてください。');
  if (!ok) { expCode.focus(); expCode.select(); }
});
impCode.addEventListener('input', updateImport);
expBoxes.forEach((b) => b.addEventListener('change', refreshExport));
mergeBtn.addEventListener('click', () => doImport('merge'));
replaceBtn.addEventListener('click', () => {
  if (!impParsed) return;
  if (replaceBtn.dataset.armed === '1') { disarmReplace(); doImport('replace'); return; }
  replaceBtn.dataset.armed = '1';
  replaceBtn.textContent = '本当に置き換える（今の記録は消えます）';
  replaceTimer = setTimeout(disarmReplace, 4000);
});
// 別のタブで記録が変わったとき
window.addEventListener('storage', (e) => {
  if (e.key === RK || e.key === null) { rec = loadRec(); refreshCounts(); }
});

document.querySelectorAll('.ph').forEach(phrasify);
refreshCounts();
})();
</script>
