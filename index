    Array.from(rec.keys()).forEach((k) => {
      const q = QBYS.get(k);
      if (q && (parsed.mask & LV[q.lv].bit)) rec.delete(k);
    });
  }
  let added = 0, updated = 0;
  parsed.items.forEach((it) => {
    const cur = rec.get(it.q.s);
    if (!cur) { rec.set(it.q.s, { s: it.s, t: it.t }); added++; return; }
    if (cur.s === it.s) { if (it.t > cur.t) cur.t = it.t; return; }
    // 結果が食い違うとき：新しい方を採用。同時刻なら安全側（苦手）
    if (it.t > cur.t || (it.t === cur.t && it.s === 'w')) { rec.set(it.q.s, { s: it.s, t: it.t }); updated++; }
  });
