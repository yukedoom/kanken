  });
}
function setText(node, text) { node.textContent = text; phrasify(node); }
function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}
function shuffleArr(a) {
  const r = a.slice();
  for (let i = r.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = r[i]; r[i] = r[j]; r[j] = t; }
  return r;
}

/* ================= 学習記録（正解済み・苦手） =================
   rec: 問題文 -> { s: 'd'（正解済み）| 'w'（苦手）, t: 記録した時刻（1970年からの経過分。0は時刻不明） }
   保存先はこのブラウザの localStorage。保存できない環境でも、メモリ上では動きます。 */
const RK = 'kanken2-yomi-rec-v2';
const OLD_WK = 'kanken2-yomi-weak-v1';   // 旧形式（移行用に読むだけ）
const OLD_DK = 'kanken2-yomi-done-v1';
// 字体を改めた問題：旧→新の問題文
const MIG = {
  '赤字を【補填】する。': '赤字を【補塡】する。',
  '市民としての権利を【剥奪】される。': '市民としての権利を【剝奪】される。',
  '壁のポスターを【剥がす】。': '壁のポスターを【剝がす】。'
};
let storageOK = (function () {
  try { localStorage.setItem('kk2-probe', '1'); localStorage.removeItem('kk2-probe'); return true; } catch (e) { return false; }
})();
function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); return true; } catch (e) { storageOK = false; return false; } }
function readOldList(key) {
  const raw = lsGet(key);
  if (!raw) return [];
  try { const a = JSON.parse(raw); return Array.isArray(a) ? a.filter((x) => typeof x === 'string') : []; } catch (e) { return []; }
}
function loadRec() {
  const m = new Map();
  const raw = lsGet(RK);
  if (raw) {
    try {
      const a = JSON.parse(raw);
      if (Array.isArray(a)) {
        a.forEach((r) => {
          if (Array.isArray(r) && typeof r[0] === 'string' && (r[1] === 'd' || r[1] === 'w')) {
            m.set(r[0], { s: r[1], t: Math.max(0, Math.floor(Number(r[2])) || 0) });
          }
        });
      }
    } catch (e) { /* 壊れていたら空から始める */ }
    return m;
  }
  // 旧形式（v1）から移行
  readOldList(OLD_DK).forEach((q) => m.set(MIG[q] || q, { s: 'd', t: 0 }));
  readOldList(OLD_WK).forEach((q) => { const k = MIG[q] || q; if (!m.has(k)) m.set(k, { s: 'w', t: 0 }); });
  if (m.size) {
    try { lsSet(RK, JSON.stringify(Array.from(m, (e) => [e[0], e[1].s, e[1].t]))); } catch (e) { /* 続行 */ }
  }
  return m;
}
let rec = loadRec();
function saveRec() { lsSet(RK, JSON.stringify(Array.from(rec, (e) => [e[0], e[1].s, e[1].t]))); }
function stOf(q) { const r = rec.get(q.s); return r ? r.s : ''; }
function isDone(q) { return stOf(q) === 'd'; }
function isWeak(q) { return stOf(q) === 'w'; }
function nowMin() { return Math.floor(Date.now() / 60000); }
function localCounts(lv) {
  let d = 0, w = 0;
  BANK.forEach((q) => {
    if (lv && q.lv !== lv) return;
    const st = stOf(q);
    if (st === 'd') d++; else if (st === 'w') w++;
  });
  return { d: d, w: w };
}

/* ---- 選んでいる級（このブラウザに覚えておく） ---- */
const LVK = 'kanken2-yomi-level-v1';
let curLv = (function () { const v = lsGet(LVK); return (v && Object.prototype.hasOwnProperty.call(LV, v)) ? v : '2'; })();

/* ---- 引き継ぎコード（画面に依存しない部分） ----
   新形式  "kk3." + 含む級(16進1字) + グループ… + "." + チェック値(16進8字)
     グループ ＝ 状態(d=正解済み / w=苦手)1字 + 記録時刻6字(36進) + 件数3字(36進) + 問題ID 6字(36進)×件数
     同じ状態・同じ時刻（＝同じ回に解いた）問題を1グループにまとめ、IDも短くして、コードを短くしています。
   旧形式  "kk2.1."（2級だけの版）も読み込めます。 */
const CODE3 = 'kk3.';
const CODE2 = 'kk2.1.';
function fnv32(str) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h >>> 0).toString(16).padStart(8, '0');
}
function id30(str) { return (parseInt(fnv32(str), 16) & 0x3fffffff).toString(36).padStart(6, '0'); }
const QID = new Map();       // 6字ID -> 問題
const QID_OLD = new Map();   // 旧形式の8桁ID -> 問題
BANK.forEach((q) => {
  QID_OLD.set(fnv32(q.s), q);
  let k = 0, id;
  do { id = id30(k ? q.s + '#' + k : q.s); k++; } while (QID.has(id));   // 万一の衝突は、決まった順で付け直す
  q.id = id;
  QID.set(id, q);
});

function buildCode(lvSet) {
  let mask = 0;
  LEVELS.forEach((l) => { if (lvSet.has(l.k)) mask |= l.bit; });
  const groups = new Map();
  let nd = 0, nw = 0;
  BANK.forEach((q) => {
    if (!lvSet.has(q.lv)) return;
    const r = rec.get(q.s);
    if (!r) return;
    const key = r.s + '|' + r.t;
    let g = groups.get(key);
    if (!g) { g = { s: r.s, t: r.t, ids: [] }; groups.set(key, g); }
    g.ids.push(q.id);
    if (r.s === 'd') nd++; else nw++;
  });
  const list = Array.from(groups.values()).sort((a, b) => (a.s === b.s ? a.t - b.t : (a.s < b.s ? -1 : 1)));
  let body = '';
  list.forEach((g) => { body += g.s + g.t.toString(36).padStart(6, '0') + g.ids.length.toString(36).padStart(3, '0') + g.ids.join(''); });
  const head = CODE3 + mask.toString(16) + body;
  return { code: head + '.' + fnv32(head), nd: nd, nw: nw, mask: mask };
