<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>漢検 読みテスト（準2級〜1級）</title>
<link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #e9eeee;
  --grid: rgba(31, 63, 115, .07);
  --sheet: #fbfcfc;
  --ink: #18212b;
  --muted: #566272;
  --indigo: #1f3f73;
  --onindigo: #ffffff;
  --line: #b7c3cb;
  --pen: #d3281e;
  --pen-bg: rgba(211, 40, 30, .07);
  --font: "BIZ UDPGothic", "Hiragino Sans", "Yu Gothic UI", "Meiryo", sans-serif;
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --paper: #0f141a;
    --grid: rgba(141, 176, 234, .07);
    --sheet: #171e27;
    --ink: #e7edf3;
    --muted: #9aa7b6;
    --indigo: #8db0ea;
    --onindigo: #0f141a;
    --line: #334150;
    --pen: #ff6a5c;
    --pen-bg: rgba(255, 106, 92, .1);
  }
}
:root[data-theme="dark"] {
  --paper: #0f141a;
  --grid: rgba(141, 176, 234, .07);
  --sheet: #171e27;
  --ink: #e7edf3;
  --muted: #9aa7b6;
  --indigo: #8db0ea;
  --onindigo: #0f141a;
  --line: #334150;
  --pen: #ff6a5c;
  --pen-bg: rgba(255, 106, 92, .1);
}
html { scroll-padding-top: env(safe-area-inset-top, 0px); }
*, *::before, *::after { box-sizing: inherit; }
body {
  margin: 0;
  background-color: var(--paper);
  background-image:
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 28px 28px;
  color: var(--ink);
  font-family: var(--font);
  line-height: 1.7;
  -webkit-text-size-adjust: 100%;
}
.wrap { max-width: 760px; margin: 0 auto; padding: 24px 16px 56px; }
[hidden] { display: none !important; }

/* ---------- hero ---------- */
.hero { margin-bottom: 26px; }
.title {
  margin: 0 0 14px;
  padding-bottom: 8px;
  border-bottom: 3px solid var(--indigo);
  color: var(--indigo);
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 .7rem;
  line-height: 1.3;
}
.title .t1 { font-size: clamp(2.1rem, 9vw, 3rem); font-weight: 700; letter-spacing: .06em; }
.title .t2 { font-size: clamp(1.1rem, 4.2vw, 1.4rem); font-weight: 400; letter-spacing: .12em; }
.hero-body { padding: 0; }
.hero-body p { margin: 0 0 10px; max-width: 34em; }
.sample {
  font-family: var(--font);
  background: var(--sheet);
  border: 1px solid var(--line);
  padding: 10px 14px;
  font-size: 1.05rem;
}
.sample small { display: block; font-family: var(--font); color: var(--muted); font-size: .8rem; margin-top: 2px; }
.t { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }

/* ---------- sheet / buttons ---------- */
.sheet { background: var(--sheet); border: 2px solid var(--indigo); }
.pad { padding: 18px 18px 22px; }
fieldset { border: 0; margin: 0 0 20px; padding: 0; min-width: 0; }
legend { padding: 0; margin-bottom: 8px; font-weight: 700; color: var(--indigo); }
.opts { display: flex; flex-wrap: wrap; gap: 8px; }
.opt { position: relative; }
.opt input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
.opt span {
  display: inline-block;
  border: 1.5px solid var(--indigo);
  border-radius: 2px;
  padding: 7px 14px;
  font-weight: 400;
  color: var(--ink);
  background: transparent;
}
.opt small { color: var(--muted); margin-left: 6px; font-size: .78rem; }
.opt input:checked + span { background: var(--indigo); color: var(--onindigo); }
.opt input:checked + span small { color: inherit; opacity: .85; }
.opt input:focus-visible + span { outline: 3px solid var(--indigo); outline-offset: 2px; }
.opt input:disabled + span { opacity: .45; border-style: dashed; }
.opt input:disabled { cursor: not-allowed; }
.check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
.check input { width: 18px; height: 18px; accent-color: var(--indigo); }
.btn {
  font: inherit;
  font-weight: 700;
  border: 2px solid var(--indigo);
  background: transparent;
  color: var(--indigo);
  padding: 11px 22px;
  border-radius: 2px;
  cursor: pointer;
}
.btn:hover { background: color-mix(in srgb, var(--indigo) 10%, transparent); }
.btn.primary { background: var(--indigo); color: var(--onindigo); }
.btn.primary:hover { filter: brightness(1.08); background: var(--indigo); }
.btn:focus-visible, .linkbtn:focus-visible, .q input:focus-visible { outline: 3px solid var(--indigo); outline-offset: 2px; }
.btn.block { width: 100%; font-size: 1.05rem; padding: 14px; }
.note { color: var(--muted); font-size: .86rem; margin: 14px 0 0; }
.warn { color: var(--pen); font-weight: 700; margin: 10px 0 0; }
.linkbtn { font: inherit; background: none; border: 0; color: var(--indigo); text-decoration: underline; cursor: pointer; padding: 4px 2px; }

/* ---------- test ---------- */
.bar {
  position: sticky;
  top: env(safe-area-inset-top, 0px);
  z-index: 5;
  background: var(--sheet);
  border-bottom: 2px solid var(--indigo);
  padding: 8px 14px 0;
}
.bar-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.bar b { font-family: var(--font); font-size: 1.1rem; }
.prog { height: 4px; margin: 8px -14px 0; background: var(--line); }
.prog i { display: block; height: 100%; width: 0; background: var(--indigo); transition: width .15s; }
ol.qs { list-style: none; margin: 0; padding: 0; }
.q, .r { display: grid; grid-template-columns: 3rem 1fr; border-top: 1px solid var(--line); scroll-margin: 5rem 0 7rem; }
.q:first-child, .r:first-child { border-top: 0; }
.no {
  grid-column: 1; grid-row: 1 / span 2;
  display: flex; flex-direction: column; align-items: center; gap: 6px;
  padding-top: 13px;
  border-right: 1px solid var(--line);
  font-family: var(--font); font-weight: 700; color: var(--indigo);
}
.s {
  grid-column: 2;
  margin: 0;
  padding: 12px 14px 6px;
  font-family: var(--font);
  font-size: 1.15rem; line-height: 1.95;
}
.ans { grid-column: 2; padding: 0 14px 14px; }
.q input {
  width: 100%;
  font: inherit; font-size: 18px; color: var(--ink);
  background: var(--paper);
  border: 1.5px solid var(--line);
  border-radius: 2px;
  padding: 10px 12px;
}
.q input::placeholder { color: var(--muted); opacity: .7; font-size: 15px; }
.q input:focus { border-color: var(--indigo); background: var(--sheet); }
.q.filled .no { background: color-mix(in srgb, var(--indigo) 9%, transparent); }
.submit {
  position: sticky; bottom: 0; z-index: 5;
  display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
  background: var(--sheet);
  border-top: 2px solid var(--indigo);
  padding: 12px 14px calc(12px + env(safe-area-inset-bottom, 0px));
}
.submit .msg { margin: 0; font-size: .9rem; color: var(--muted); }
.submit .msg.warn { color: var(--pen); }

@media (min-width: 640px) {
  .q, .r { grid-template-columns: 3.4rem 1fr 15rem; }
  .no { grid-row: auto; }
  .s { padding: 14px; }
  .ans { grid-column: 3; padding: 0; border-left: 1px solid var(--line); display: flex; }
  .q input { flex: 1; height: 100%; min-height: 58px; border: 0; padding: 0 14px; background: transparent; }
  .q input:focus { background: var(--paper); outline-offset: -3px; }
  .q input:focus-visible { outline-offset: -3px; }
}

/* ---------- result ---------- */
.summary { text-align: center; padding: 30px 16px 26px; border-bottom: 2px solid var(--indigo); }
.score { position: relative; display: inline-block; padding: 20px 44px; margin-bottom: 8px; }
.score svg { position: absolute; left: -10px; top: -4px; width: calc(100% + 20px); height: calc(100% + 8px); overflow: visible; fill: none; stroke: var(--pen); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
.score svg path { animation: draw .9s ease-out .1s both; }
@keyframes draw { from { stroke-dashoffset: var(--len, 1000); } to { stroke-dashoffset: 0; } }
.score .num { position: relative; font-family: var(--font); font-weight: 700; font-size: clamp(2.8rem, 12vw, 4.2rem); line-height: 1.1; color: var(--pen); }
.score .num small { font-size: .42em; font-weight: 400; margin-left: .15em; }
.summary p { margin: 6px 0 0; }
.summary .pct { font-weight: 700; font-size: 1.1rem; }
.summary .small { color: var(--muted); font-size: .85rem; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; padding: 16px; border-bottom: 1px solid var(--line); }
.review-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 12px 16px; border-bottom: 1px solid var(--line); background: var(--paper); }
.r.ng { background: var(--pen-bg); }
.mark { font-family: var(--font); font-weight: 700; font-size: 1.9rem; line-height: 1; color: var(--pen); }
.r .s { grid-row: 1; padding-bottom: 4px; }
.r .tag { display: inline-block; margin-left: 8px; font-family: var(--font); font-size: .72rem; color: var(--muted); border: 1px solid var(--line); padding: 0 6px; vertical-align: middle; }
.r .ans { display: block; padding: 0 14px 14px; }
.r .ans div { line-height: 1.5; }
.r .lbl { color: var(--muted); font-size: .76rem; margin-right: 6px; }
.r .val { font-size: 1.1rem; font-weight: 400; }
.r .right { margin-top: 4px; color: var(--pen); font-weight: 700; }
.r .right .val { font-weight: 700; font-size: 1.15rem; }
@media (min-width: 640px) {
  .r .s { grid-row: auto; padding-bottom: 14px; }
  .r .ans { padding: 14px; border-left: 1px solid var(--line); }
}
/* ---------- 文の折り返し（意味のまとまりで改行する） ---------- */
.ph, .s, .sample { word-break: keep-all; overflow-wrap: anywhere; line-break: strict; }
.nb { white-space: nowrap; }
.lvdesc { margin: 8px 0 0; font-size: .9rem; color: var(--muted); min-height: 1.4em; }
.expsel { margin: 2px 0 8px; }
.expsel .opts { gap: 6px 16px; }
.expsel small { color: var(--muted); margin-left: 4px; font-size: .78rem; }

/* ---------- 記録の引き継ぎ ---------- */
.xfer { margin-top: 18px; background: var(--sheet); border: 2px solid var(--indigo); }
.xfer > summary { cursor: pointer; padding: 12px 16px; font-weight: 700; color: var(--indigo); }
.xfer > summary:focus-visible { outline: 3px solid var(--indigo); outline-offset: -3px; }
.xfer-body { padding: 4px 16px 18px; border-top: 1px solid var(--line); }
.xfer h3 { margin: 18px 0 6px; font-size: 1rem; color: var(--indigo); }
.xfer .lbl { display: block; font-size: .9rem; margin-bottom: 4px; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.info { margin: 4px 0 8px; font-size: .92rem; min-height: 1.4em; }
.okmsg { color: var(--indigo); font-weight: 700; }
textarea.code {
  display: block; width: 100%; resize: vertical;
  font: 16px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  word-break: break-all;
  color: var(--ink); background: var(--paper);
  border: 1.5px solid var(--line); border-radius: 2px; padding: 10px 12px;
}
textarea.code:focus { outline: 3px solid var(--indigo); outline-offset: 1px; border-color: var(--indigo); }
.acts { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 4px; }
.btn:disabled { opacity: .45; cursor: not-allowed; }
.btn:disabled:hover { background: transparent; }
.btn.primary:disabled:hover { background: var(--indigo); filter: none; }
@media (prefers-reduced-motion: reduce) {
  .score svg path { animation: none; }
  .prog i { transition: none; }
}
</style>
</head>
<body>
<div class="wrap">

  <!-- ===== 開始画面 ===== -->
  <main id="start">
    <header class="hero">
      <h1 class="title"><span class="t1">漢検<span id="lvTitle">2級</span></span><span class="t2">読みテスト</span></h1>
      <div class="hero-body">
        <p class="ph">文中の<span class="t">下線部</span>の読みを、テキストボックスに入力して答えます。<span class="nb">この級の収録は<b id="totalCount">0</b>問です。</span></p>
        <div class="sample ph">例　近所の人と朝の<span class="t">挨拶</span>を交わす。<small>→「あいさつ」と入力</small></div>
      </div>
    </header>

    <div class="sheet pad">
      <fieldset>
        <legend>級</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="level" value="j2"><span>準2級<small id="c-lv-j2"></small></span></label>
          <label class="opt"><input type="radio" name="level" value="2" checked><span>2級<small id="c-lv-2"></small></span></label>
          <label class="opt"><input type="radio" name="level" value="j1"><span>準1級<small id="c-lv-j1"></small></span></label>
          <label class="opt"><input type="radio" name="level" value="1"><span>1級<small id="c-lv-1"></small></span></label>
        </div>
        <p class="lvdesc ph" id="lvDesc"></p>
      </fieldset>
      <fieldset>
        <legend>出題範囲</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="scope" value="all" checked><span>すべて<small id="c-all"></small></span></label>
          <label class="opt"><input type="radio" name="scope" value="on"><span>音読みの熟語<small id="c-on"></small></span></label>
          <label class="opt"><input type="radio" name="scope" value="kun"><span>訓読み・送り仮名<small id="c-kun"></small></span></label>
          <label class="opt"><input type="radio" name="scope" value="sp"><span>熟字訓・特殊な読み<small id="c-sp"></small></span></label>
          <label class="opt"><input type="radio" name="scope" value="weak" id="weakRadio"><span>苦手だけ<small id="c-weak"></small></span></label>
        </div>
        <p class="note ph" id="doneNote" style="margin-top:10px"></p>
        <button class="linkbtn" id="resetBtn" type="button" hidden>この級の正解済みの記録をリセット</button>
      </fieldset>
      <fieldset>
        <legend>問題数</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="count" value="10"><span>10問</span></label>
          <label class="opt"><input type="radio" name="count" value="30" checked><span>30問<small>本番と同じ</small></span></label>
          <label class="opt"><input type="radio" name="count" value="50"><span>50問</span></label>
          <label class="opt"><input type="radio" name="count" value="100"><span>100問</span></label>
          <label class="opt"><input type="radio" name="count" value="all"><span>全問</span></label>
        </div>
      </fieldset>
      <fieldset>
        <label class="check"><input type="checkbox" id="shuffle" checked>順番をシャッフルする</label>
      </fieldset>
      <button class="btn primary block" id="startBtn" type="button">テストを始める</button>
      <p class="warn ph" id="startMsg" hidden></p>
      <p class="note ph">答えは「ひらがな」で入力します（カタカナや全角・半角は自動で補正）。変換を確定してからEnterを押すと、次の問題へ移ります。各範囲の数字は、まだ出題していない問題の数です。一度正解した問題は出題されません。まちがえた問題は「苦手」として記録され、「苦手だけ」を選んだときに出題されます（記録はこのブラウザに保存されます）。級の分け方は、各級の配当漢字を目安にしたもので、公式の出題と完全には一致しません。</p>
    </div>

    <details class="xfer" id="xfer">
      <summary>記録の引き継ぎ（別の端末に移す）</summary>
      <div class="xfer-body">
        <p class="note ph">「正解済み」と「苦手」の記録を、文字だけの<b>引き継ぎコード</b>にして別の端末へ移せます。書き出し側でコードをコピーし、読み込み側の欄に貼り付けてください。すべての級をまとめても、級を選んでも書き出せます。以前の版で作ったコード（kk2.1. で始まる）も読み込めます。</p>
        <p class="warn ph" id="storeWarn" hidden>このブラウザでは記録を保存できないため、ページを閉じると記録が消えます。必要なら、先にコードを書き出してください。</p>

        <h3>この端末の記録を書き出す</h3>
        <fieldset class="expsel">
          <legend>書き出す級</legend>
          <div class="opts">
            <label class="check"><input type="checkbox" class="expLv" value="j2" checked>準2級<small id="e-j2"></small></label>
            <label class="check"><input type="checkbox" class="expLv" value="2" checked>2級<small id="e-2"></small></label>
            <label class="check"><input type="checkbox" class="expLv" value="j1" checked>準1級<small id="e-j1"></small></label>
            <label class="check"><input type="checkbox" class="expLv" value="1" checked>1級<small id="e-1"></small></label>
          </div>
        </fieldset>
        <p id="expInfo" class="info ph"></p>
        <label class="sr" for="expCode">引き継ぎコード（書き出し用）</label>
        <textarea class="code" id="expCode" rows="4" readonly spellcheck="false" autocomplete="off"></textarea>
        <div class="acts"><button class="btn" id="copyBtn" type="button">コードをコピー</button></div>
        <p class="info ph" id="copyMsg" role="status" aria-live="polite"></p>

        <h3>別の端末の記録を読み込む</h3>
        <label class="lbl" for="impCode">引き継ぎコードを貼り付け</label>
        <textarea class="code" id="impCode" rows="4" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder="kk3. で始まるコードを貼り付け"></textarea>
        <p class="info ph" id="impInfo" role="status" aria-live="polite"></p>
        <div class="acts">
          <button class="btn primary" id="mergeBtn" type="button" disabled>統合して読み込む</button>
          <button class="btn" id="replaceBtn" type="button" disabled>置き換えて読み込む</button>
        </div>
        <p class="note ph"><b>統合</b>：今の記録を残したまま、コードの記録を足します。同じ問題で結果が食い違うときは、新しく解いた方を採用します（おすすめ）。<br><b>置き換え</b>：コードに含まれる級の今の記録を消して、コードの内容に入れ替えます。コードに含まれない級の記録は、そのまま残ります。</p>
      </div>
    </details>
  </main>

  <!-- ===== テスト画面 ===== -->
  <main id="test" hidden>
    <div class="sheet">
      <div class="bar">
        <div class="bar-row">
          <div>回答 <b id="answered">0</b> / <b id="total">0</b></div>
          <button class="linkbtn" id="quitBtn" type="button">中断する</button>
        </div>
        <div class="prog"><i id="progBar"></i></div>
      </div>
      <ol class="qs" id="qlist"></ol>
      <div class="submit">
        <p class="msg" id="submitMsg">すべて答えたら採点します。</p>
        <button class="btn primary" id="gradeBtn" type="button">採点する</button>
      </div>
    </div>
  </main>

  <!-- ===== 結果画面 ===== -->
  <main id="result" hidden>
    <div class="sheet">
      <div class="summary" id="summary"></div>
      <div class="actions">
        <button class="btn primary" id="againBtn" type="button">同じ条件で続ける</button>
        <button class="btn" id="homeBtn" type="button">最初に戻る</button>
      </div>
      <div class="review-head">
        <strong>答え合わせ</strong>
        <label class="check"><input type="checkbox" id="onlyWrong">まちがいだけ表示</label>
      </div>
      <ol class="qs" id="rlist"></ol>
    </div>
  </main>

</div>

<script>
(function () {
'use strict';

/* ================= 問題データ =================
   書式: "問題文（出題部分を【】で囲む）|正解|別解…" */

// 音読みの熟語
const ON = [
"近所の人と朝の【挨拶】を交わす。|あいさつ",
"【曖昧】な返事では相手も困るだろう。|あいまい",
"偉大な先人に【畏敬】の念を抱く。|いけい",
"緊張のあまり【萎縮】してしまった。|いしゅく",
"辞書を引いて【語彙】を増やす。|ごい",
"風邪で【咽喉】が腫れている。|いんこう",
"雨続きで【憂鬱】な毎日だ。|ゆううつ",
"【怨恨】による犯行とみられる。|えんこん",
"子どもは好奇心が【旺盛】だ。|おうせい",
"彼は【臆病】な性格で知られる。|おくびょう",
