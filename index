  const body = t.slice(CODE2.length, dot), chk = t.slice(dot + 1);
  if (!/^[0-9a-f]{8}$/.test(chk) || fnv32(CODE2 + body) !== chk) return { err: 'broken' };
  if (body.length % 15 !== 0) return { err: 'format' };
  const byId = new Map();
  for (let i = 0; i < body.length; i += 15) {
    const m = /^([0-9a-f]{8})([dw])([0-9a-z]{6})$/.exec(body.slice(i, i + 15));
    if (!m) return { err: 'format' };
    keepNewer(byId, { id: m[1], s: m[2], t: parseInt(m[3], 36) });
