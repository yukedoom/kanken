const $ = (s) => document.querySelector(s);
// 級の定義（bit は、引き継ぎコードに「どの級を含むか」を記すのに使う）
const LEVELS = [
  { k: 'j2', name: '準2級', bit: 1, pass: 70, desc: '高校在学程度（常用漢字およそ1,950字）' },
  { k: '2',  name: '2級',   bit: 2, pass: 80, desc: '高校卒業・大学・一般程度（常用漢字2,136字すべて）' },
  { k: 'j1', name: '準1級', bit: 4, pass: 80, desc: '大学・一般程度（約3,000字。人名用漢字などを含む）' },
  { k: '1',  name: '1級',   bit: 8, pass: 80, desc: '大学・一般程度（約6,000字。表外漢字を含む難問）' }
];
const LV = {};
LEVELS.forEach((l) => { LV[l.k] = l; });
const parse = (arr, c, lv) => arr.map((r) => { const p = r.split('|'); return { s: p[0], a: p.slice(1), c: c, lv: lv }; });
const BANK = [].concat(
  parse(J2_ON, 'on', 'j2'), parse(J2_KUN, 'kun', 'j2'), parse(J2_SP, 'sp', 'j2'),
  parse(ON, 'on', '2'), parse(KUN, 'kun', '2'), parse(SP, 'sp', '2'),
  parse(J1_ON, 'on', 'j1'), parse(J1_KUN, 'kun', 'j1'), parse(J1_SP, 'sp', 'j1'),
  parse(L1_ON, 'on', '1'), parse(L1_KUN, 'kun', '1'), parse(L1_SP, 'sp', '1')
);
const QBYS = new Map(BANK.map((q) => [q.s, q]));
const CAT = { on: '音読み', kun: '訓読み', sp: '特殊' };
function lvBank(lv) { return BANK.filter((q) => q.lv === lv); }

function norm(s) {
  return String(s).normalize('NFKC').replace(/[\s\u3000]/g, '').replace(/[\u30A1-\u30F6]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
}

/* ---- 文を意味のまとまりで折り返す ----
   「ひらがなの直後に漢字・カタカナが来る」位置に改行の候補（<wbr>）を置き、
   CSS（word-break: keep-all）と組み合わせて、単語の途中で改行されないようにします。 */
function isHira(c) { return /[\u3041-\u3096]/.test(c); }
