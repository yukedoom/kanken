function parseV3(t) {
  const dot = t.lastIndexOf('.');
  if (dot < CODE3.length + 1) return { err: 'broken' };
  const head = t.slice(0, dot), chk = t.slice(dot + 1);
  if (!/^[0-9a-f]{8}$/.test(chk) || fnv32(head) !== chk) return { err: 'broken' };
  const mask = parseInt(head.charAt(CODE3.length), 16);
  if (!(mask >= 1 && mask <= 15)) return { err: 'format' };
  const body = head.slice(CODE3.length + 1);
  const byId = new Map();
  let i = 0;
  while (i < body.length) {
    if (i + 10 > body.length) return { err: 'format' };
    const st = body.charAt(i), tm = body.substr(i + 1, 6), cn = body.substr(i + 7, 3);
    if ((st !== 'd' && st !== 'w') || !/^[0-9a-z]{6}$/.test(tm) || !/^[0-9a-z]{3}$/.test(cn)) return { err: 'format' };
    const n = parseInt(cn, 36), t0 = parseInt(tm, 36);
    i += 10;
    if (i + n * 6 > body.length) return { err: 'format' };
    for (let j = 0; j < n; j++) {
      const id = body.substr(i + j * 6, 6);
      if (!/^[0-9a-z]{6}$/.test(id)) return { err: 'format' };
      keepNewer(byId, { id: id, s: st, t: t0 });
    }
    i += n * 6;
  }
  return finish(mask, byId, QID);
}
function parseV2(t) {
  const dot = t.lastIndexOf('.');
