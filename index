  const f = document.createDocumentFragment();
  let buf = '', tbuf = '', inT = false, prev = '';
  const flush = () => { if (buf) { f.append(buf); buf = ''; } };
  for (const ch of s) {
    if (ch === '【' && !inT) {
      flush();
      if (isHira(prev)) f.append(document.createElement('wbr'));
      inT = true; tbuf = '';
      continue;
    }
    if (ch === '】' && inT) {
      const sp = document.createElement('span'); sp.className = 't'; sp.textContent = tbuf; f.append(sp);
      inT = false; prev = tbuf.charAt(tbuf.length - 1);
      continue;
    }
    if (inT) { tbuf += ch; continue; }
    if (isHira(prev) && isCont(ch)) { flush(); f.append(document.createElement('wbr')); }
    buf += ch; prev = ch;
  }
  flush();
  return f;
}
function phrasify(root) {
  const w = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
  const nodes = [];
  let n;
  while ((n = w.nextNode())) nodes.push(n);
  nodes.forEach((t) => {
    const v = t.nodeValue;
    if (t.parentElement && t.parentElement.closest('.nb')) return;   // 改行させない句の中には候補を入れない
    if (!/[\u3041-\u3096][\u30A1-\u30FA\u4E00-\u9FFF\u3005\u3006\u30F6]/.test(v)) return;
    const f = document.createDocumentFragment();
    let buf = '';
    for (let i = 0; i < v.length; i++) {
      if (i > 0 && isHira(v.charAt(i - 1)) && isCont(v.charAt(i))) { f.append(buf); buf = ''; f.append(document.createElement('wbr')); }
      buf += v.charAt(i);
    }
    f.append(buf);
