function normCode(text) { return String(text).normalize('NFKC').replace(/[\s\u200b-\u200d\ufeff]+/g, '').toLowerCase(); }
function keepNewer(byId, it) {
  const old = byId.get(it.id);
  if (!old || it.t > old.t || (it.t === old.t && it.s === 'w')) byId.set(it.id, it);
}
function finish(mask, byId, idMap) {
  const items = [];
  let unknown = 0, nd = 0, nw = 0;
  const by = {};
  LEVELS.forEach((l) => { by[l.k] = { d: 0, w: 0 }; });
  byId.forEach((it) => {
    const q = idMap.get(it.id);
    if (!q || !(mask & LV[q.lv].bit)) { unknown++; return; }
    items.push({ q: q, s: it.s, t: it.t });
    if (it.s === 'd') { nd++; by[q.lv].d++; } else { nw++; by[q.lv].w++; }
  });
